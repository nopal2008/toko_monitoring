{
  "info": {
    "_postman_id": "bd941e95-f812-486c-a713-90a387eb74a1",
    "name": "Toko Monitoring - Supplier API",
    "description": "Tes API Supplier Laravel dengan Sanctum Bearer Token, role, validasi, dan soft delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "cashier_email",
      "value": ""
    },
    {
      "key": "cashier_password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Supplier tanpa token (401)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer invalid-token"
          }
        ],
        "url": "{{base_url}}/api/v1/suppliers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Token tidak valid ditolak dengan 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login owner/admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login berhasil dengan 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.environment.set('token', pm.response.json().data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - GET daftar supplier",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/suppliers?per_page=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Daftar supplier mengembalikan 200 dan data array', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - POST buat supplier (201)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Supplier Postman {{$guid}}\",\n  \"phone\": \"081234567890\",\n  \"email\": \"supplier.postman@example.test\",\n  \"address\": \"Alamat tes Postman\",\n  \"is_active\": true,\n  \"tenant_id\": 999999\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/suppliers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Supplier dibuat dengan 201', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().data.id).to.exist;",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.environment.set('supplier_id', pm.response.json().data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - GET detail supplier",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/suppliers/{{supplier_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Detail supplier mengembalikan 200', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.id).to.eql(Number(pm.environment.get('supplier_id')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - PATCH update supplier",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Supplier Postman Updated\",\n  \"phone\": \"081299998888\",\n  \"tenant_id\": 999999\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/suppliers/{{supplier_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Supplier diperbarui; tenant_id tidak diekspos oleh API', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.name).to.eql('Supplier Postman Updated');",
              "    pm.expect(pm.response.json().data).not.to.have.property('tenant_id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - POST validasi email (422)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Supplier Invalid\",\n  \"email\": \"not-an-email\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/suppliers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Email invalid ditolak dengan 422', function () {",
              "    pm.response.to.have.status(422);",
              "    pm.expect(pm.response.json().errors.email).to.exist;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - DELETE arsipkan supplier (204)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/suppliers/{{supplier_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Supplier diarsipkan dengan 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - GET supplier yang sudah diarsipkan (404)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/suppliers/{{supplier_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Supplier terhapus tidak dapat diakses (404)', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
