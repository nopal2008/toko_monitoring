    },
    {
      "name": "12 - Login role cashier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{cashier_email}}\",\n  \"password\": \"{{cashier_password}}\",\n  \"device_name\": \"Postman cashier test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Akun cashier aktif menerima token untuk pengujian role', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.environment.set('cashier_token', pm.response.json().data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Role cashier ditolak (403)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{cashier_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/suppliers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Role cashier tidak dapat mengakses supplier (403)', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
